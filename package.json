{
  "name": "money",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "shared",
    "sync",
    "server"
  ],
  "scripts": {
    "check:workspaces": "node scripts/check-workspaces.ts",
    "typecheck": "npm run check:workspaces && tsc --noEmit",
    "test": "TZ=Europe/Amsterdam node --test 'shared/**/*.test.ts' 'sync/**/*.test.ts' 'server/**/*.test.ts' 'fixtures/**/*.test.ts' 'scripts/**/*.test.ts'",
    "server": "node scripts/dev-server.ts",
    "fixtures": "node fixtures/generate.ts",
    "lint": "eslint .",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
