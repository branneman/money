# Settings for the sync. Copy to .env.sandbox for sandbox runs and fill it in there.
# Never commit a file that holds a value for EB_APP_ID or EB_PRIVATE_KEY.

# The Enable Banking application id, from the Control Panel.
EB_APP_ID=

# The application's private key: the PEM file, base64-encoded onto one line.
#   base64 < private.pem | tr -d '\n'
EB_PRIVATE_KEY=

# The redirect address registered for the application. Must be HTTPS. The page does not
# have to load: auth reads the address the browser was sent to.
EB_REDIRECT_URL=https://localhost/auth-callback

# The configuration file: banks, accounts and import formats. See docs/sync.md.
CONFIG_PATH=tmp/sandbox/config.json

# The archive, and the sync's state. Both must exist; neither is ever created.
DATA_DIR=tmp/sandbox/data
STATE_DIR=tmp/sandbox/state

# How many days before the last success a nightly fetch reaches back. Default 30.
# LOOKBACK_DAYS=30

# How many days before a consent ends `status` starts to exit non-zero. Default 14.
# CONSENT_WARN_DAYS=14
