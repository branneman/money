#!/bin/sh
# The command line, by one name, so nobody has to remember where it lives in the image.
# The server's three commands go to the server; everything else is the sync's.
case "${1:-}" in
serve | hash-password | rotate-session-secret)
    exec node /app/server/src/cli.ts "$@"
    ;;
*)
    # The sync's directories, unless the caller chose others. Given here and not by the
    # image, because the server's container inherits the image's environment and refuses
    # to start with STATE_DIR in it.
    DATA_DIR="${DATA_DIR:-/data}"
    STATE_DIR="${STATE_DIR:-/state}"
    export DATA_DIR STATE_DIR
    if [ "$#" -eq 0 ]; then
        # No command: the sync's usage line, then the server's, and the sync's exit code.
        status=0
        node /app/sync/src/cli.ts || status=$?
        echo "usage: serve | hash-password | rotate-session-secret" >&2
        exit "$status"
    fi
    exec node /app/sync/src/cli.ts "$@"
    ;;
esac
